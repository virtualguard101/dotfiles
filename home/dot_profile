# ~/.profile: login shells (sh; bash only without ~/.bash_profile; zsh where ~/.zprofile sources it, e.g. Kali).
# Every source is guarded: a failing `.` aborts a POSIX login shell, and with it the desktop session.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) [ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH" ;;
esac
if [ -f "$HOME/.cargo/env" ]; then . "$HOME/.cargo/env"; fi
