[user]
	name = {{ if eq .chezmoi.os "windows" }}virtualguard101{{ else }}vg101{{ end }}
	email = virtualguard101@gmail.com
[http]
	proxy = 127.0.0.1:7897
[credential "https://github.com"]
	provider = generic
[color]
	ui = auto
[alias]
	graph = log --all --graph --decorate --oneline
{{- if eq .chezmoi.os "windows" }}
	ida = !cd \"${GIT_PREFIX:-.}\" && \"C:/Program Files/IDA Professional 9.5/tools/teams/git-ida.exe\"
{{- else }}
	ida = !cd \"${GIT_PREFIX:-.}\" && \"{{ .chezmoi.homeDir }}/.local/share/ida-pro-9.5/tools/teams/git-ida\"
{{- end }}
[core]
	editor = vim
[merge]
	tool = vscode
[diff]
	tool = vscode
[init]
	defaultBranch = main
[mergetool]
	keepBackup = false
[lfs]
	concurrenttransfers = 3
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
{{- if eq .chezmoi.os "windows" }}
[safe]
	directory = *
{{- end }}
