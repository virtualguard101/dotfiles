{{- /*
  Rendered from .chezmoidata/platforms.toml.
  - [platforms]: targets of the other platform are ignored.
  - [requires]: targets whose tag this machine lacks (.tags, from the chezmoi config) are ignored.
    A config without .tags (written before tags existed) applies no [requires] filtering.
  Parent directories of ignored targets are ignored too, unless they also hold targets this machine
  keeps — otherwise the parent itself stays managed, e.g. Windows' readonly_Documents/ would chmod
  ~/Documents read-only on Linux.
*/ -}}
{{- $os := .chezmoi.os -}}
{{- $missing := list -}}
{{- if and (hasKey . "tags") (hasKey . "requires") -}}
{{-   range $tag, $targets := .requires -}}
{{-     if not (has $tag $.tags) }}{{ $missing = concat $missing $targets }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- $own := list -}}
{{- $hide := $missing -}}
{{- range $platform, $targets := .platforms -}}
{{-   if or (eq $platform "shared") (eq $platform $os) -}}
{{-     range $t := $targets -}}
{{-       $drop := false -}}
{{-       range $m := $missing }}{{ if or (eq $t $m) (hasPrefix (print $m "/") $t) }}{{ $drop = true }}{{ end }}{{ end -}}
{{-       if not $drop }}{{ $own = append $own $t }}{{ end -}}
{{-     end -}}
{{-   else -}}
{{-     $hide = concat $hide $targets -}}
{{-   end -}}
{{- end -}}
{{- $ignored := dict -}}
{{- range $target := $hide -}}
{{-   $_ := set $ignored $target true -}}
{{-   $parts := splitList "/" $target -}}
{{-   range $i := until (sub (len $parts) 1 | int) -}}
{{-     $parent := join "/" (slice $parts 0 (add $i 1)) -}}
{{-     $needed := false -}}
{{-     range $own }}{{ if or (eq . $parent) (hasPrefix (print $parent "/") .) }}{{ $needed = true }}{{ end }}{{ end -}}
{{-     if not $needed }}{{ $_ := set $ignored $parent true }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- range $path := keys $ignored | sortAlpha }}
{{ $path }}
{{- end }}
