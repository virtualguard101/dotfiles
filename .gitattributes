# Line endings: LF everywhere in the repo and on Windows checkouts too (core.autocrlf has no effect)
* text=auto eol=lf

# age ciphertext: never convert line endings
*.age -text

# Windows-native scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary / app-private formats: stored as-is
*.ptb -text
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.gpg binary
