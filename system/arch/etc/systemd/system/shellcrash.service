[Unit]
Description=ShellCrash Core
After=network.target

[Service]
Type=simple
User=shellcrash
StandardOutput=null
ExecStartPre=/usr/share/ShellCrash/starts/bfstart.sh
ExecStart=/usr/share/ShellCrash/CrashCore run -D /usr/share/ShellCrash -C /tmp/ShellCrash/jsons >/dev/null
ExecStartPost=/usr/share/ShellCrash/starts/afstart.sh
ExecStopPost=/usr/share/ShellCrash/starts/fw_stop.sh
Restart=on-abnormal
RestartSec=10s
LimitNOFILE=infinity


[Install]
WantedBy=multi-user.target
